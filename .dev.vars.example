# Clef and Jev use the remote AI binding and Wrangler login.
# No TypeSafe API key is needed. Run: pnpm exec wrangler login
# Optional: copy to .dev.vars to override public vars from wrangler.jsonc.

# WORKERS_PLAN=free
# AI_CLEF_ENABLED=true
# AI_JEV_ENABLED=true
# AI_DEFAULT_PROVIDER=clef
# CLEF_MIN_CONFIDENCE=0
# CLEF_TIMEOUT_MS=6000
# JEV_MIN_CONFIDENCE=0
