# Local Worker secret for development. Gitignored.
# Copy this file to .dev.vars and fill in your actual API key:
#   cp .dev.vars.example .dev.vars
#
# Production deployment uses:
#   pnpm exec wrangler secret put TYPESAFE_API_KEY

TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Override public vars defined in wrangler.jsonc if needed
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# JEV_MIN_CONFIDENCE=0
