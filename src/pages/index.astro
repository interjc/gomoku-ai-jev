---
import '../styles/global.css';

export const prerender = true;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gomoku Jev</title>
  <script is:inline>
    try {
      var params = new URLSearchParams(location.search);
      var choice = {
        lang: { param: 'lang', storageKey: 'gomoku_lang', allowed: ['en', 'ja', 'zh'] },
        theme: { param: 'theme', storageKey: 'gomoku_theme', allowed: ['light', 'dark'] },
      };
      function pick(name) {
        var spec = choice[name];
        function norm(value) {
          if (typeof value !== 'string') return null;
          var v = value.trim().toLowerCase();
          return spec.allowed.indexOf(v) === -1 ? null : v;
        }
        var fromUrl = null;
        params.forEach(function (value, key) {
          if (fromUrl == null && key.toLowerCase() === spec.param) {
            var canonical = norm(value);
            if (canonical) fromUrl = canonical;
          }
        });
        var stored = null;
        try { stored = norm(localStorage.getItem(spec.storageKey)); } catch (e) {}
        return fromUrl || stored;
      }
      var lang = pick('lang');
      if (lang) document.documentElement.lang = lang === 'zh' ? 'zh-CN' : lang;
      document.documentElement.classList.toggle('dark', pick('theme') === 'dark');
    } catch (e) {}
  </script>
</head>
<body>
  <header class="app-header">
    <h1 id="app-title">Gomoku Jev</h1>
    <div class="header-actions">
      <div class="dropdown" id="lang-dropdown">
        <button
          id="btn-lang"
          class="btn btn-sm dropdown-toggle"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label="Select language"
        >
          <svg class="lang-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="8" cy="8" r="6.75" />
            <path d="M1.25 8h13.5M8 1.25c2 2.2 3 4.5 3 6.75s-1 4.55-3 6.75c-2-2.2-3-4.5-3-6.75s1-4.55 3-6.75z" />
          </svg>
          <span id="btn-lang-text">English</span>
          <svg class="dropdown-chevron" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul id="lang-menu" class="dropdown-menu" role="menu">
          <li role="none">
            <button type="button" class="dropdown-item" role="menuitem" data-lang="en">
              <span>English</span>
              <span class="check-mark" aria-hidden="true">✓</span>
            </button>
          </li>
          <li role="none">
            <button type="button" class="dropdown-item" role="menuitem" data-lang="ja">
              <span>日本語</span>
              <span class="check-mark" aria-hidden="true">✓</span>
            </button>
          </li>
          <li role="none">
            <button type="button" class="dropdown-item" role="menuitem" data-lang="zh">
              <span>简体中文</span>
              <span class="check-mark" aria-hidden="true">✓</span>
            </button>
          </li>
        </ul>
      </div>
      <button id="btn-theme" class="btn btn-sm btn-icon" type="button" aria-label="Toggle theme">🌙</button>
      <a
        class="btn btn-sm btn-icon"
        href="https://github.com/interjc/gomoku-ai-jev"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
    </div>
  </header>

  <main class="app-main">
    <aside class="controls">
      <div class="controls-bar">
        <div class="control-group">
          <label id="label-difficulty" for="sel-difficulty">Difficulty</label>
          <select id="sel-difficulty" class="select">
            <option value="easy">Easy</option>
            <option value="medium">Medium</option>
            <option value="hard" selected>Hard</option>
            <option value="master">Master</option>
          </select>
        </div>

        <div class="control-group">
          <label id="label-color" for="sel-color">Play as</label>
          <select id="sel-color" class="select">
            <option value="black">Black (first)</option>
            <option value="white">White (second)</option>
          </select>
        </div>

        <div class="button-row">
          <button id="btn-new" class="btn btn-primary">New Game</button>
          <button id="btn-undo" class="btn">Undo</button>
        </div>

        <div id="status" class="status-text">Your turn</div>
        <div id="thinking" class="thinking" hidden>AI thinking…</div>
      </div>

      <section class="history-panel">
        <h2 id="history-title" class="history-title">Move History</h2>
        <ol id="history-list" class="history-list"></ol>
      </section>
    </aside>

    <section class="board-section">
      <canvas id="board-canvas" class="board-canvas"></canvas>
    </section>
  </main>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
